<?xml version="1.0" encoding="utf-8"?>
<!-- Window content only, and only from the packages that own the USB dialog: this service reads the
     prompt's text and clicks its buttons, so it is scoped to the two system packages that can show
     one. flagReportViewIds is what lets it recognise the dialog's own button ids. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:description="@string/usb_auto_confirm_desc"
    android:notificationTimeout="50"
    android:packageNames="com.android.systemui,android" />
